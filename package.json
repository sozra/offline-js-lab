{
  "name": "offline-js-lab",
  "version": "0.2.1",
  "description": "A local cross-platform JavaScript and TypeScript scratchpad built with Electron.",
  "main": "electron/main.cjs",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check-source.mjs",
    "test": "node --test",
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "dist:nsis": "electron-builder --win nsis --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "pack:mac": "electron-builder --dir --mac",
    "pack:win": "electron-builder --dir --win --x64"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "monaco-editor": "0.56.0"
  },
  "build": {
    "appId": "com.offlinejslab.desktop",
    "productName": "Offline JS Lab",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "electron/runner.cjs",
      "node_modules/esbuild/**/*",
      "node_modules/@esbuild/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/monaco-editor/min",
        "to": "monaco"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
